# Toasted Oats - per-machine settings. install.sh copies this to /opt/oats/oats.env once;
# after that the copy is yours and is never overwritten. Nothing in here is secret today;
# if Stripe keys ever arrive they go here, not in site.json.

OATS_BIND=127.0.0.1
OATS_PORT=8090

# URL path the site lives under. The Cloudflare tunnel forwards the full path, so this must
# match the path in the tunnel rule. Empty means the site is at the root of its host.
OATS_PREFIX=/oats

# Scheme + host the public uses. Canonical URLs, the sitemap, share images and the
# same-origin check on the API all come from this. Leave unset only on a laptop.
OATS_PUBLIC_ORIGIN=https://2birds1joint.org

# Extra origins allowed to post to /api/*, comma separated. Only needed if the static copy
# of the site is ever hosted on a second domain.
OATS_ALLOWED_ORIGINS=

OATS_DB=/opt/oats/oats.db
